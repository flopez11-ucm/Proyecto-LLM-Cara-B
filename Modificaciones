stop_words = {"el", "la", "los", "las", "de", "y", "a", "en", "que"}

#Función para pre-procesar el texto
def preprocess(text):
    text = text.lower()
    for p in string.punctuation:
        text = text.replace(p, " ")
    tokens = text.split()
    tokens = [t for t in tokens if t not in stop_words]
    return tokens

