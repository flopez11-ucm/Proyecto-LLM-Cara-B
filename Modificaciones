#Función que va a calificar cada chunk con una score
#en función de cuánta relación tiene el chunk con la query en cuestión
def bm25_score(query_tokens, docs, idf, avgdl, k = 1.2, b = 0.75):
    scores = []
    for doc in docs:
        score = 0
        doc_len = len(doc)
        freq = Counter(doc)

        for term in query_tokens:
            if term in freq:
                numerator = freq[term] * (k + 1)
                denominator = freq[term] + k * (1 - b + b * doc_len / avgdl)
                score += idf[term] * (numerator / denominator)

        scores.append(score)
    return scores

# MODIFICACION, extraemos el bm25
def build_bm25(corpus):
    docs = [c["tokens"] for c in corpus]
    N = len(docs)
    doc_lengths = [len(d) for d in docs]
    avgdl = sum(doc_lengths) / N

    df = Counter()
    for doc in docs:
        df.update(set(doc))

    idf = {term: math.log(1 + (N - df[term] + 0.5) / (df[term] + 0.5)) for term in df}

    return docs, idf, avgdl







def get_contexto(tipo_contexto: int = 0, k: int = 5, tipo_chunk: int = 0, cuestionario: list[dict] = load_json()):
    # Hacemos estrategia de chunking de longitud-fija
    dict_chunks: dict = chunking(tipo_chunk)

    # Creamos una lista de chunks
    corpus = [
        {
            "id": chunk["id"],
            "text": chunk["text"],
            "tokens": preprocess(chunk["text"])
        }
        for chunk in dict_chunks
    ]

    context = []

    if tipo_contexto == 0:  # cuerpo baseline
        context = [""] * 50



# MODIFICADO
    elif tipo_contexto == 1:
    # --- BM25 CALCULADO UNA SOLA VEZ ---
    docs = [c["tokens"] for c in corpus]
    N = len(docs)

    # Longitudes e índice promedio del documento
    doc_lengths = [len(d) for d in docs]
    avgdl = sum(doc_lengths) / N

    # Cálculo eficiente de df(term)
    df = Counter()
    for doc in docs:
        df.update(set(doc))   # más limpio y rápido

    # Cálculo vectorizado del IDF
    idf = {
        term: math.log(1 + (N - df[term] + 0.5) / (df[term] + 0.5))
        for term in df
    }


# MODIFICACIÓN un poco mala, no la entiendo mucho... (Se la pedí a ChatGPT)
    # --- BÚSQUEDA BM25 PARA CADA PREGUNTA ---
    num_preguntas = min(len(cuestionario), 50) # Lo dejamos como variable de elección

    for i in range(num_preguntas):
        # Preprocesamos la query
        query_tokens = preprocess(cuestionario[i]['question'])

        # BM25 score (ya optimizado previamente)
        scores = bm25_score(query_tokens, docs, idf, avgdl, k=1.2, b=0.75)

        # Opción más eficiente que argsort (top-k sin ordenar todo)
        top_k_idx = np.argpartition(scores, -k)[-k:]
        # Ordenarlos descendentemente (solo k elementos)
        top_k_idx = top_k_idx[np.argsort([scores[t] for t in top_k_idx])[::-1]]

        # Recuperamos los textos
        context.append("\n".join(corpus[j]["text"] for j in top_k_idx))




    elif tipo_contexto == 2:
        # particularidades de dense retrieval
        docs = [c["text"] for c in corpus]

        # Cargamos el modelo de embeddings
        model = SentenceTransformer("all-MiniLM-L6-v2")

        # Generamos embeddings de todos los chunks en el corpus
        embeddings = model.encode(docs, convert_to_numpy=True)
        # y los adaptamos al tipo que necesita float32
        embeddings = embeddings.astype('float32')

        index = faiss.IndexFlatL2(embeddings.shape[1])  # L2 = distancia euclidiana
        index.add(embeddings)  # agregamos todos los chunks

        for i in range(50):
            query_emb = model.encode([cuestionario[i]['question']], convert_to_numpy=True)
            query_emb = query_emb.astype('float32')

            distances, top_k_idx = index.search(query_emb, k)
            top_k_idx = top_k_idx[0]  # top k índices del primer query

            # Recuperamos los textos
            context.append("\n".join([corpus[j]["text"] for j in top_k_idx]))
    return context




def evaluacion (context, cuestionario, schema_mcq, client, n_preguntas, n_iteraciones):
    resultados = [["" for _ in range(n_preguntas + 2)] for _ in range(n_iteraciones)]
    for i in range(n_iteraciones):
        aciertos = 0
        fallos = 0
        for j in range(min(len(cuestionario), n_preguntas)):
            pregunta = f"""
            Responde a la siguiente pregunta de opción múltiple ÚNICAMENTE usando la información del CONTEXTO.
            CONTEXTO:
            {context[j]}
            PREGUNTA:
            {cuestionario[j]['question']}
            OPCIONES:
            A. {cuestionario[j]['answers']['A']}
            B. {cuestionario[j]['answers']['B']}
            C. {cuestionario[j]['answers']['C']}
            D. {cuestionario[j]['answers']['D']}
            """
            response = client.models.generate_content(
                model = "gemini-2.5-flash",
                contents = pregunta,
                config = {
                    "response_mime_type": "application/json",
                    "response_schema": schema_mcq
                }
            )

            raw_text = response.candidates[0].content.parts[0].text
            respuesta = json.loads(raw_text)["answer"]

            resultados[i][j] = respuesta
            if (respuesta == cuestionario[j]["correct_answer"]):
                aciertos += 1
            else:
                fallos += 1

            time.sleep(6.1) # Esto por qué, por ser gratis?
        resultados[i][n_preguntas] = aciertos
        resultados[i][n_preguntas + 1] = fallos
    return resultados



def guardar_resultado(
    nombre_fichero,
    modelo,
    chunking,
    resultados,
    contexto,
    k
):
    entrada = {
        "timestamp": datetime.now().isoformat(),
        "modelo": modelo,                     # "BM25" o "Dense"
        "chunking": chunking,                 # tipo de chunking usado
        "resultados": resultados,
        "chunks_recuperados": contexto,  # lista de IDs o textos
        "num_chunks": k
    }

    with open(nombre_fichero, "a", encoding="utf-8") as f:
        json.dump(entrada, f, ensure_ascii = False, indent = 4)
