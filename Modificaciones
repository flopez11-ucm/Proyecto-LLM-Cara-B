def fixed_lenght_chunking(text: str, chunk_size: int, overlap: int):
    """
    Divide un texto en chunks de tamaño `chunk_size` (en número de palabras),
    con `overlap` palabras superpuestas entre chunks consecutivos.

    Args:
        text: texto completo a chunkear
        chunk_size: número de palabras por chunk
        overlap: número de palabras que se repiten entre chunks consecutivos

    Returns:
        Lista de strings, cada una es un chunk
    """
    words = text.split()
    chunks = []
    start = 0
    chunk_id = 0

    while start < len(words):
        end = start + chunk_size
        chunk = words[start:end]
        chunks.append({
            "id": chunk_id,
            "text": " ".join(chunk)
        })
        start += chunk_size - overlap  # superposición
        chunk_id += 1
    return chunks

